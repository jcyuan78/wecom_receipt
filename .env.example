# ============================================================
# 企业微信自建应用配置（必填）
# 在「管理后台 → 我的企业 → 企业信息」里取 CorpID
# ============================================================
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_APP_SECRET=

# 「应用管理 → 应用 → 自建应用 → 接收消息 → 设置API接收」里的三个值
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

# ============================================================
# 服务监听
# ============================================================
WECOM_HOST=0.0.0.0
WECOM_PORT=8080
# 公网访问地址，仅用于文档/排查，不参与逻辑
WECOM_PUBLIC_BASE_URL=https://files.example.com

# ============================================================
# 存储
# ============================================================
WECOM_DATA_DIR=data
WECOM_MAX_FILE_MB=100

# ============================================================
# 下载后触发什么
#   noop    : 只写 data/jobs/<msg_id>.json（下一阶段可监听该目录）
#   command : 执行本地命令
#   http    : POST job JSON 到 webhook
#   auto    : 本地 AI 自动分类 → 发票入库 / 作业归档（本文档主推）
# ============================================================
WECOM_PROCESSOR=auto

# --- auto 模式：Ollama -------------------------------------------------
# 必须是支持图片的模型：qwen2.5vl:7b / qwen3-vl / llava 等
# 注意 qwen3:8b 是纯文本模型，不能读图
WECOM_OLLAMA_BASE_URL=http://127.0.0.1:11434
WECOM_OLLAMA_MODEL=qwen2.5vl:7b
WECOM_OLLAMA_TIMEOUT=300
WECOM_OLLAMA_KEEP_ALIVE=10m
# 视觉模型的上下文长度；图片较大时调大，避免返回空内容
WECOM_OLLAMA_NUM_CTX=8192

# --- auto 模式：目录 ---------------------------------------------------
WECOM_RECEIPT_DIR=data/receipt
WECOM_HOMEWORK_DIR=data/homework
WECOM_OTHER_DIR=data/other

# 发票数据库（留空 = data/invoices.sqlite3）
# WECOM_INVOICE_DB=data/invoices.sqlite3

WECOM_DEFAULT_CURRENCY=JPY
# AI 自评置信度低于此值时标记为「需复核」
WECOM_INVOICE_MIN_CONFIDENCE=0.5
# 矫正后图片最长边
WECOM_RECEIPT_MAX_SIDE=2200
# 一张图最多拆成几张发票
WECOM_INVOICE_MAX_REGIONS=6
# 是否保留原始照片到 data/receipt/_originals
WECOM_KEEP_ORIGINAL=true

# --- command / http 模式 ----------------------------------------------
# WECOM_PROCESSOR_COMMAND=python "C:\work\analyze.py"
# WECOM_PROCESSOR_WEBHOOK_URL=http://127.0.0.1:9000/jobs
WECOM_PROCESSOR_TIMEOUT=300

# 收到图片/文件后自动回复的文字，留空则不回复
WECOM_AUTO_REPLY=文件已收到，正在处理中。
# 识别完成后用应用消息把结果回复给发送人
WECOM_NOTIFY_RESULTS=true
WECOM_NOTIFY_FAILURE=true

# 后台线程
WECOM_WORKER_ENABLED=true
WECOM_WORKER_POLL_SECONDS=1
WECOM_MAX_ATTEMPTS=3

# 调试接口 /api/messages 的访问令牌，留空则关闭该接口
WECOM_ADMIN_TOKEN=

WECOM_LOG_LEVEL=INFO
